{
  "name": "@competition-platform/format-cypher-battles",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validators": {
      "types": "./dist/validators/score-validator.d.ts",
      "default": "./dist/validators/score-validator.js"
    },
    "./scoring": {
      "types": "./dist/scoring/aggregation.d.ts",
      "default": "./dist/scoring/aggregation.js"
    }
  },
  "typesVersions": {
    "*": {
      "validators": [
        "./dist/validators/score-validator.d.ts"
      ],
      "scoring": [
        "./dist/scoring/aggregation.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@competition-platform/format-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.2.4",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
