{
  "name": "competition-platform",
  "private": true,
  "scripts": {
    "setup": "./scripts/setup.sh",
    "doctor": "./scripts/doctor.sh",
    "reset": "./scripts/reset.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter='!@competition-platform/tests'",
    "test:e2e": "pnpm --filter @competition-platform/tests test",
    "test:e2e:ui": "pnpm --filter @competition-platform/tests test:ui",
    "test:e2e:install": "pnpm --filter @competition-platform/tests install:browsers",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "prepare": "husky 2>/dev/null || true"
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
